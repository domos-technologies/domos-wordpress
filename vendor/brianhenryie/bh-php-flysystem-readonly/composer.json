{
    "name": "brianhenryie/bh-php-flysystem-readonly",
    "description": "A League Flysystem adapter which wraps another adapter: reads pass through, writes and deletes are captured in memory so nothing ever touches the underlying filesystem. For --dry-run modes.",
    "type": "library",
    "keywords": [
        "flysystem",
        "filesystem",
        "adapter",
        "readonly",
        "read-only",
        "dry-run",
        "in-memory",
        "copy-on-write"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Henry",
            "email": "BrianHenryIE@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-fileinfo": "*",
        "league/flysystem": "^2.5 || ^3.0",
        "league/flysystem-memory": "^2.0 || ^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.4",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.4 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10 || ^11 || ^12",
        "squizlabs/php_codesniffer": "^3.9 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "BrianHenryIE\\FlysystemReadOnly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrianHenryIE\\FlysystemReadOnly\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": [
            "if [ \"$XDEBUG_MODE\" != \"coverage\" ]; then echo \"Run with: XDEBUG_MODE=coverage composer test-coverage\"; exit 1; fi;",
            "phpunit --coverage-text --coverage-clover tests/_reports/clover.xml --coverage-html tests/_reports/html"
        ],
        "test-flysystem2": [
            "composer update --prefer-dist --no-interaction --with='league/flysystem:^2.5' --with='league/flysystem-memory:^2.0'",
            "phpunit"
        ],
        "test-flysystem3": [
            "composer update --prefer-dist --no-interaction --with='league/flysystem:^3.0' --with='league/flysystem-memory:^3.0'",
            "phpunit"
        ],
        "analyze": "phpstan analyse --memory-limit=-1 --verbose",
        "cs": [
            "phpcs || true",
            "@analyze"
        ],
        "cs-fix": [
            "phpcbf || true",
            "@cs"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite against the currently installed dependencies.",
        "test-coverage": "Run the test suite with code coverage. Requires XDEBUG_MODE=coverage.",
        "test-flysystem2": "Re-resolve dependencies against league/flysystem 2.x and run the test suite.",
        "test-flysystem3": "Re-resolve dependencies against league/flysystem 3.x and run the test suite.",
        "analyze": "Run PHPStan static analysis.",
        "cs": "Run PHP_CodeSniffer and PHPStan.",
        "cs-fix": "Run PHP Code Beautifier and Fixer, then check with PHP_CodeSniffer and PHPStan."
    }
}
