{
    "name": "domos/wordpress-core",
    "type": "wordpress-plugin",
    "description": "Die domos WordPress-Integration",
    "homepage": "https://domos.de",
    "authors": [
        {
            "name": "Lukas Mateffy (domos GmbH)",
            "email": "lukas@domos.de",
            "homepage": "https://domos.de"
        }
    ],
    "keywords": [
        "wordpress"
    ],
    "support": {
        "issues": "https://github.com/roots/clover/issues",
        "forum": "https://discourse.roots.io/"
    },
    "autoload": {
        "psr-4": {
            "Domos\\Core\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Domos\\Core\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "roots/acorn": "^5.0",
        "ext-json": "*",
        "yahnis-elsts/plugin-update-checker": "^5.2",
        "domos/schema": "^1.2.2",
        "deliciousbrains/wp-background-processing": "^1.4",
        "ozdemirburak/iris": "^4.1"
    },
    "scripts": {
        "lint": "pint",
        "test": "phpunit",
        "strauss": "vendor/bin/strauss",
        "post-autoload-dump": [
            "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
        ]
    },
    "require-dev": {
        "laravel/pint": "^1.2",
        "phpunit/phpunit": "^10.5",
        "brianhenryie/strauss": "^0.31"
    },
    "extra": {
        "strauss": {
            "target_directory": "src/Dependencies",
            "namespace_prefix": "Domos\\Core\\Dependencies\\",
            "classmap_prefix": "DOMOS_",
            "packages": [
                "deliciousbrains/wp-background-processing"
            ],
            "delete_vendor_packages": false,
            "update_call_sites": false,
            "exclude_from_copy": {
                "file_patterns": [
                    "/\\.circleci/",
                    "/\\.github/",
                    "/\\.phpcs\\.xml/",
                    "/bin/",
                    "/tests/",
                    "/Makefile/",
                    "/phpunit\\.xml/",
                    "/composer\\.lock/",
                    "/wp-background-processing\\.php/",
                    "/\\.gitignore/"
                ]
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "__repositories": [
        {
            "type": "path",
            "url": "../../schema.immo"
        }
    ],
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
